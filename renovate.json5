{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // 共通の方針（スケジュール・自動マージ・リリース後の待機期間など）はプリセットに集約する。
  // https://github.com/seijikohara/renovate-config
  extends: ["github>seijikohara/renovate-config:default.json5"],
  packageRules: [
    {
      // プラグインとルールは textlint 本体が読み込んで実行する。
      // 本体とルールの組み合わせで校正の結果が変わると文書の修正が要るため、1 つの PR の lint:text でまとめて確かめる。
      description: "textlint 本体とプラグイン・ルールを 1 つの PR にまとめる",
      groupName: "textlint",
      matchPackageNames: ["textlint", "textlint-*"],
    },
    {
      // Starlight は Renovate 組み込みの astro モノレポのグループに含まれない。
      // Starlight の新しいバージョンは astro の最低バージョンを引き上げるため、astro と同じ PR で更新する。
      description: "Astro 本体と公式インテグレーションを 1 つの PR にまとめる",
      groupName: "astro",
      matchPackageNames: ["astro", "@astrojs/*"],
    },
    {
      // oxlint は必要な oxlint-tsgolint のバージョンをピア依存で宣言する。
      // oxlint-tsgolint は TypeScript に合わせてメジャーを上げる。
      // メジャーも同じ PR にまとめ、対応する oxlint-tsgolint なしに oxlint が入らないようにする。
      description: "oxc のリンタとフォーマッタを 1 つの PR にまとめる",
      groupName: "linting and formatting",
      matchPackageNames: ["oxlint", "oxfmt", "oxlint-tsgolint"],
      separateMajorMinor: false,
    },
    {
      // 型定義の更新はビルドの出力を変えないため、まとめて型の検査で確かめる。
      // React の型定義は除き、Renovate 組み込みの group:react に任せる。group:react は @types/react と @types/react-dom を react・react-dom と同じ PR にまとめる。
      // 本ルールは group:react より後に適用される。除かないと React のメジャー更新が本体と型定義の 2 つの PR に分かれ、片方だけマージされると型エラーになる。
      description: "React 以外の型定義を 1 つの PR にまとめる",
      groupName: "type definitions",
      matchPackageNames: ["@types/*", "!@types/react", "!@types/react-dom"],
    },
    {
      // katex 0.18 で CSS のクラス名に `katex-` の接頭辞が付いた。本文の数式は rehype-katex が依存する katex 0.16 が描画し、
      // ページは直接依存の katex の CSS を読み込む。直接依存だけを 0.18 以上にすると、ビルドは通ったまま本文の数式の表示が崩れる。
      // rehype-katex が katex 0.18 以上に対応したら、この制限を外す。katex と rehype-katex を同じ PR で上げ、
      // src/styles/global.css と scripts/figures/lint.ts のクラス名を合わせて直す。
      description: "rehype-katex が katex 0.18 に対応するまで katex を 0.17 系に留める",
      matchPackageNames: ["katex"],
      allowedVersions: "<0.18",
    },
    {
      // dagre の更新で図のノード配置とエッジの経路が変わる（3.1 では 62 図中 20 図）。
      // CI は図の見た目を比べないため、自動マージせず、`pnpm run figures:diff` で差分を確かめてからマージする。
      description: "図の配置を変える dagre の更新を自動マージしない",
      matchPackageNames: ["@dagrejs/dagre"],
      automerge: false,
    },
    {
      // Starlight は 1.0 未満で、マイナーバージョンに破壊的変更を含む（0.42 ではモバイルメニューのマークアップが変わった）。
      // ビルドが通っても表示が変わりうるため、マイナー以上の更新は自動マージせず、変更履歴を確かめてからマージする。
      // astro グループの PR に Starlight のマイナー更新が含まれる場合は、その PR 全体が自動マージされない。
      description: "Starlight のマイナー以上の更新を自動マージしない",
      matchPackageNames: ["@astrojs/starlight"],
      matchUpdateTypes: ["major", "minor"],
      automerge: false,
    },
  ],
}
