{
  "name": "physics-roadmap",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --deny-warnings --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint:text": "textlint \"**/*.{md,mdx}\"",
    "lint:text:fix": "textlint --fix \"**/*.{md,mdx}\"",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run roadmap:check && pnpm run roadmap:terms --all && pnpm run lint:text",
    "roadmap:check": "tsx scripts/roadmap/check.ts",
    "roadmap:index": "tsx scripts/roadmap/index.ts && oxfmt --write docs/roadmap/upstream-index.json",
    "roadmap:paths": "tsx scripts/roadmap/paths.ts",
    "roadmap:inventory": "tsx scripts/roadmap/inventory.ts",
    "roadmap:terms": "tsx scripts/roadmap/terms.ts",
    "figures:shot": "tsx scripts/figures/shot.ts",
    "figures:lint": "tsx scripts/figures/lint.ts",
    "figures:diff": "tsx scripts/figures/diff.ts",
    "figures:widths": "tsx scripts/figures/widths.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/react": "^7.0.0",
    "@astrojs/starlight": "^0.42.8",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource/noto-serif-jp": "^5.2.8",
    "@visx/clip-path": "^4.0.0",
    "@visx/curve": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/legend": "^4.0.0",
    "@visx/marker": "^4.0.0",
    "@visx/network": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "astro": "^7.4.4",
    "katex": "0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lefthook": "^2.1.9",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright-core": "^1.64.1",
    "textlint": "^15.7.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-plugin-mdx": "^1.1.0",
    "textlint-rule-preset-ja-spacing": "^3.0.2",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
