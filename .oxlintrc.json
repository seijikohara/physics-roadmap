{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "off"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": ["dist", ".astro", "node_modules"],
  "overrides": [
    {
      "files": ["scripts/**", "astro.config.ts"],
      "rules": {
        "no-var": "error",
        "prefer-const": "error",
        "no-param-reassign": ["error", { "props": true }],
        "unicorn/no-array-sort": ["error", { "allowExpressionStatement": false }],
        "unicorn/no-array-reverse": ["error", { "allowExpressionStatement": false }],
        "typescript/prefer-readonly-parameter-types": [
          "error",
          {
            "ignoreInferredTypes": true,
            "treatMethodsAsReadonly": true,
            "allow": [
              {
                "from": "package",
                "package": "playwright-core",
                "name": ["Browser", "BrowserContext", "Page"]
              },
              {
                "from": "lib",
                "name": [
                  "Node",
                  "Text",
                  "Element",
                  "SVGGraphicsElement",
                  "SVGGeometryElement",
                  "SVGSVGElement",
                  "SVGMarkerElement",
                  "CSSStyleDeclaration"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-var": "error",
        "prefer-const": "error",
        "no-param-reassign": ["error", { "props": true }],
        "unicorn/no-array-sort": ["error", { "allowExpressionStatement": false }],
        "unicorn/no-array-reverse": ["error", { "allowExpressionStatement": false }],
        "typescript/prefer-readonly-parameter-types": [
          "error",
          {
            "ignoreInferredTypes": true,
            "treatMethodsAsReadonly": true,
            "allow": [
              {
                "from": "package",
                "package": "react",
                "name": ["ReactNode", "ReactElement", "CSSProperties"]
              }
            ]
          }
        ]
      }
    }
  ]
}
